{
  "feature": "Game Module (Tactical Simulation)",
  "root": "src/features/game",
  "description": "The core gameplay engine comprising the 3D Board, Rules Engine, AI Subsystems, and React UI.",
  "structure": {
    "App.tsx": "The main entry point for the Game feature. It manages the high-level view states (3D Board, 2D Slices, Skill Tree), initializes the game engine hooks, and renders the modal overlays (Promotion, New Game).",
    "types.ts": "Central type definitions for the game domain. Exports interfaces for GameState, Piece, Position, MatchStats, and Enums for PieceType and PlayerColor.",
    "ai": {
      "AIKernel.ts": "The decision-making root. Implements the Minimax algorithm with Alpha-Beta pruning to select the best move based on the EvaluationEngine's scoring.",
      "AIProfiles.ts": "Defines personality archetypes (e.g., 'Berserker', 'Guardian') that apply specific biases to the Knowledge Graph's tensor weights.",
      "AiPromotionService.ts": "Specialized logic for the AI's promotion phase. Simulates the board state to decide between a standard Queen promotion or rescuing a captured unit for morale recovery.",
      "DomainTypes.ts": "Type definitions for the AI's cognitive domains (Tactics, Structure, Prediction) used in the Synthesis/Skill system.",
      "EvaluationEngine.ts": "Stateless evaluator that calculates the Master Piecewise (M-Pw) score. It computes Risk (Material), Reward (Board Control), and Relation (Morale) for any given board state.",
      "KnowledgeGraph.ts": "The AI's long-term memory structure. Manages the 3D array of TensorNodes and applies learned Skill modifiers to specific tensor indices.",
      "MetricMaps.ts": "Generates global heatmaps (Threat Map, Coverage Map, Axial Zone Control) used by the AI to assess board safety and influence.",
      "ProfileManager.ts": "Service that loads specific AIProfiles into the Knowledge Graph, adjusting the AI's 'innate bias' based on the selected difficulty or persona.",
      "SkillData.ts": "Database of available AI skills (e.g., 'Aggressor I', 'Predictive Change') and their specific numeric effects on tensor indices.",
      "SkillSystem.ts": "Defines the interfaces and effect types (Learning Rate, Decay, Importance) for the AI's progression system.",
      "StatTracker.ts": "Event-driven telemetry system. Tracks individual piece performance (kills, survival turns, formation coherence) to populate the end-game stats.",
      "StrategicEval.ts": "Helper functions that classify raw numeric deltas into the RRR states (-1, 0, +1) and symbolic tags (Offense, Defense, Strategy).",
      "SynthesisRules.ts": "Logic for emergent AI behaviors. Defines rules where combinations of domain mastery trigger new high-level strategic capabilities.",
      "TelemetryUtils.ts": "Mathematical utilities for 3D vector operations, grid manipulation, and Manhattan distance calculations.",
      "tensorTypes.ts": "Enum definitions for the 64-float Tensor Index (TI) mapping, defining what each index in a TensorNode represents.",
      "useAILoop.ts": "React hook that manages the AI's turn lifecycle. Triggers the calculation thread when it is Black's turn and dispatches the resulting move."
    },
    "api": {
      "vantageService.ts": "Constructs the localized context payload for the LLM Vantage Chat. Filters board data to only show what a specific piece can 'see' and 'feel' (Morale)."
    },
    "core": {
      "Board3D.tsx": "The main 3D visualization component using React Three Fiber. Renders the board grid, pieces, move highlights, and lighting environment.",
      "Board2D.tsx": "A 2D orthographic slice viewer. Renders a specific cross-section of the board (X, Y, or Z axis) for precise tactical analysis.",
      "BoardFactory.ts": "Factory class responsible for initializing the board layout, spawning pieces with correct IDs/ranks, and establishing hierarchy links.",
      "HyperBoard.ts": "The authoritative game engine class. Manages the 8x8x8 TensorNode grid, synchronizes piece state, and triggers the metric update loop.",
      "MoraleSystem.ts": "Manages Team Morale calculations. Converts the raw EvaluationEngine output into the UI-ready TeamStats object.",
      "Pieces.ts": "Barrel file exporting all concrete Piece classes for easy importing.",
      "TensorConfig.ts": "Configuration file defining the constants for Tensor size and Cube count.",
      "TensorNode.ts": "Represents a single voxel (cube) in the game space. Stores the local state vector (Occupancy, Threat, Influence) for the AI.",
      "game_logic": {
        "gameConstants.ts": "Static constants for board dimensions and standard movement vector arrays (Orthogonal, Diagonal, Triagonal).",
        "gameLogic.ts": "Central hub re-exporting core logic functions. Acts as the bridge between the UI/React state and the core engine classes.",
        "gameStateInitializer.ts": "Provides the initial GameState object, setting up the default 'Face-to-Face' floor/ceiling deployment.",
        "moveCalculator.ts": "The centralized movement engine. Calculates valid moves for any piece, handling collision, blocking, and complex multi-phase constraints (e.g., Fractal Knight opposing axis check)."
      },
      "pieces": {
        "BasePiece.ts": "Abstract base class. Defines intrinsic properties (Material, Morale, Rank), hierarchy storage (subordinates), and shared telemetry logic.",
        "Bishop.ts": "Defines Bishop geometry (Unlimited 3D Diagonals).",
        "FractalKnight.ts": "Defines Fractal Knight geometry and Rank status (General). Inherits [2,3,0] geometry from Knight but enables Phase 2 logic.",
        "King.ts": "Defines King geometry (1-step in any direction) and high-value status.",
        "Knight.ts": "Defines Knight geometry (Strict [2,3,0] L-Shape permutations).",
        "Pawn.ts": "Defines Pawn geometry (Orthogonal 1-step, Diagonal capture) and movement directionality.",
        "Queen.ts": "Defines Queen geometry (Rook + Bishop + Triagonal vectors).",
        "Rook.ts": "Defines Rook geometry (Unlimited Orthogonal)."
      }
    },
    "data": {
      "dataService.ts.bk": "Backup/Legacy file for mock data generation. (Deprecated by BoardFactory)."
    },
    "hooks": {
      "useCubexEngine.ts": "Custom hook that instantiates the HyperBoard engine and keeps the React UI state in sync with the engine's internal state.",
      "useVantageChat.ts": "Hook managing the chat session with a specific game piece. Handles message history, API calls, and context assembly."
    },
    "state": {
      "gameReducer.ts": "Redux-style reducer managing React state transitions. Handles actions like SELECT_PIECE, MOVE_PIECE, PROMOTE_PIECE, and Turn Phase updates."
    },
    "ui": {
      "GameHUD.tsx": "Heads-up display overlay. Renders the Graveyard, Turn Phase indicators, and control tooltips.",
      "Header.tsx": "Top navigation bar. Displays the current turn, game mode, AI thinking status, and view toggles.",
      "HelpSection.tsx": "Documentation panel within the game UI explaining movement rules and piece mechanics.",
      "LayerMap.tsx": "Visual heatmap grid. Renders control/threat density for a specific board layer to assist player strategy.",
      "MetricsDashboard.tsx": "Detailed analytics view. Shows breakdowns of Risk, Reward, and Relation metrics.",
      "NewGameModal.tsx": "Configuration modal for starting a new match (HvH vs HvAI, Difficulty).",
      "PieceVantageChat.tsx": "The UI component for the LLM chat window associated with a selected piece.",
      "PieceVisuals.tsx": "Three.js component containing the 3D geometry definitions and shaders for rendering the pieces.",
      "PromotionModal.tsx": "UI overlay for selecting a promotion option (Standard Upgrade or Rescue Operation).",
      "Roster.tsx": "List view of all active pieces, displaying their individual telemetry stats (Kills, Morale, Exposure).",
      "Sidebar.tsx": "Side navigation menu for switching between 3D, 2D, Editor, and Dashboard views.",
      "SkillTree.tsx": "Interactive node graph for unlocking AI skills and upgrades.",
      "SliceNavigator.tsx": "Interactive widget for selecting the active axis and layer depth for the 2D Slice view.",
      "StrategicRadar.tsx": "Radar chart component visualizing the RRR balance (Risk/Reward/Relation) between the two teams.",
      "TeamOverview.tsx": "Dashboard panel summarizing high-level team stats (Total Morale, Kills, Check Status)."
    }
  }
}